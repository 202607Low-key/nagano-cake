<table border="1" style="border-collapse: collapse;">
  <thead>
    <tr>
      <th>商品名</th>
      <th>数量</th>
      <th>単価(税込)</th>
      <th>小計</th>
    </tr>
  </thead>
  <tbody>
    <% @cart_items.each do |cart_item| %>
      <tr>
        <td><%= cart_item.item.name %></td>
        <td><%= cart_item.amount %></td>
        <td><%= cart_item.item.with_tax_price %></td>
        <td><%= cart_item.subtotal %></td>
        <td>
          <%= form_with model: cart_item do |form| %>
            <%= form.select :amount, 1..10 %>
            <%= form.submit "更新" %>
          <% end %>
        </td>
        <td><%= button_to "取り消し", cart_item_path(cart_item), method: :delete %></td>
      </tr>
      <% @total_price += cart_item.subtotal %>
    <% end %>
  </tbody>
</table>
<p>合計金額: <%= @total_price %>円</p>
<%= button_to "カートを空にする", all_destroy_cart_items_path, method: :delete %>