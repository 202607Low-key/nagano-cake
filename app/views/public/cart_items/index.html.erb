<div class="container">
  <div class="d-flex justify-content-between align-items-center mt-3 mb-5">
    <h2 class="bg-body-secondary rounded-0 px-3 py-1 fs-4 mb-0 ms-4">ショッピングカート</h2>
    <%= button_to "カートを空にする", all_destroy_cart_items_path, method: :delete, class: "btn btn-danger" %>
  </div>

  <table class="table table-bordered mb-4">
    <thead>
      <tr>
        <th class="bg-light">商品名</th>
        <th class="bg-light">単価(税込)</th>
        <th class="bg-light action-col">数量</th>
        <th class="bg-light">小計</th>
        <th class="bg-light action-col"></th>
      </tr>
    </thead>
    <tbody>
      <% @cart_items.each do |cart_item| %>
        <tr>
          <td class="align-middle">
            <div class="d-flex align-items-center gap-2">
              <%= image_tag cart_item.item.display_image(40, 40), class: "cart-thumbnail" %>
              <%= cart_item.item.name %>
            </div>
          </td>
          <td class="align-middle"><%= number_with_delimiter(cart_item.item.with_tax_price) %></td>
          <td class="align-middle">
            <%= form_with model: cart_item, class: "d-flex gap-2" do |form| %>
              <%= form.select :amount, 1..10, { selected: cart_item.amount }, class: "form-select form-select-sm cart-amount-select" %>
              <%= form.submit "変更", class: "btn btn-success btn-sm text-nowrap" %>
            <% end %>
          </td>
          <td class="align-middle"><%= number_with_delimiter(cart_item.subtotal) %></td>
          <td class="align-middle">
            <%= button_to "削除する", cart_item_path(cart_item), method: :delete, class: "btn btn-danger btn-sm text-nowrap" %>
          </td>
        </tr>
        <% @total_price += cart_item.subtotal %>
      <% end %>
    </tbody>
  </table>

  <div class="row mb-5">
    <div class="col-6">
      <%= link_to "買い物を続ける", root_path, class: "btn btn-primary ms-4" %>
    </div>
    <div class="col-6 d-flex justify-content-end">
      <table class="table table-bordered mb-0 total-price-table">
        <tbody>
          <tr>
            <th class="bg-light">合計金額</th>
            <td class="total-price-value"><%= number_with_delimiter(@total_price) %></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="text-center">
    <%= link_to "情報入力に進む", new_order_path, class: "btn btn-success px-5" %>
  </div>
</div>