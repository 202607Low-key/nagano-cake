<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <h2 class="bg-body-secondary rounded-0 px-3 py-1 mt-3 mb-3 d-inline-block fs-4">マイページ</h2>

      <div class="row mb-2 fs-5">
        <div class="col-md-4 fw-bold">お名前</div>
        <div class="col-md-8"><%= @customer.last_name %> <%= @customer.first_name %></div>
      </div>
      <div class="row mb-4 fs-5">
        <div class="col-md-4 fw-bold">メールアドレス</div>
        <div class="col-md-8"><%= @customer.email_address %></div>
      </div>

      <%= link_to "登録情報編集", customers_information_edit_path, class: "btn btn-primary" %>
      <%= link_to "配送先一覧", addresses_path, class: "btn btn-primary" %>
      <%= link_to "注文履歴", orders_path, class: "btn btn-secondary" %>
      <%= link_to "退会はこちら", customers_unsubscribe_path, class: "btn btn-danger" %>
    </div>
  </div>
</div>