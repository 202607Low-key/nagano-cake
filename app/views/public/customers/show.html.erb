<div class="container">
  <h2 class="bg-body-secondary rounded-0 px-3 py-1 mt-3 mb-3 ms-5 d-inline-block fs-4">マイページ</h2>
  <div class="d-flex align-items-center gap-3 mb-3">
    <span class="fw-bold fs-5 label-width">登録情報</span>
    <%= link_to "編集する", customers_information_edit_path, class: "btn btn-success w-25" %>
  </div>
        
    <table class="table table-bordered">
      <tbody>
        <tr>
          <th class="bg-light">氏名</th>
          <td><%= @customer.last_name %> <%= @customer.first_name %></td>
        </tr>
        <tr>
          <th class="bg-light">カナ</th>
          <td><%= @customer.last_name_kana %> <%= @customer.first_name_kana %></td>
        </tr>
        <tr>
          <th class="bg-light">郵便番号</th>
          <td><%= @customer.postal_code %></td>
        </tr>
        <tr>
          <th class="bg-light">住所</th>
          <td><%= @customer.address %></td>
        </tr>
        <tr>
          <th class="bg-light">電話番号</th>
          <td><%= @customer.telephone_number %></td>
        </tr>
        <tr>
          <th class="bg-light">メールアドレス</th>
          <td><%= @customer.email_address %></td>
        </tr>
      </tbody>
    </table>

    <div class="d-flex align-items-center gap-3 mt-4 fmb-3">
      <span class="fw-bold fs-5 label-width">配送先</span>
      <%= link_to "一覧を見る", addresses_path, class: "btn btn-primary w-25" %>
    </div>

    <div class="d-flex align-items-center gap-3 my-3">
      <span class="fw-bold fs-5 label-width">注文履歴</span>
      <%= link_to "一覧を見る", orders_path, class: "btn btn-primary w-25" %>
    </div>
  </div>
</div>