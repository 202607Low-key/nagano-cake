<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <h2 class="bg-body-secondary rounded-0 px-3 py-1 mt-3 mb-4 d-inline-block fs-4">退会確認</h2>
      <p class="fs-5 mb-4">本当に退会しますか？ <%= @customer.last_name %>さん</p>
      <div class="d-flex gap-2">
        <%= button_to "退会する", customers_withdraw_path, method: :patch, class: "btn btn-danger" %>
        <%= link_to "キャンセル", customers_my_page_path, class: "btn btn-primary" %>
      </div>
    </div>
  </div>
</div>