<% @addresses.each do |address| %>
  <p><%= address.name %> / <%= address.postal_code %> / <%= address.address %></p>
<% end %>

<%= form_with model: Current.customer.addresses.new do |form| %>
  <%= form.label :name %>
  <%= form.text_field :name %>

  <%= form.label :postal_code %>
  <%= form.text_field :postal_code %>

  <%= form.label :address %>
  <%= form.text_field :address %>

  <%= form.submit "登録" %>
<% end %>