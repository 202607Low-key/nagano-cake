<%= form_with model: @customer do |form| %>

  <%= form.label :last_name %>
  <%= form.text_field :last_name %>

  <%= form.label :first_name %>
  <%= form.text_field :first_name %>

  <%= form.label :last_name_kana %>
  <%= form.text_field :last_name_kana %>

  <%= form.label :first_name_kana %>
  <%= form.text_field :first_name_kana %>

  <%= form.label :postal_code %>
  <%= form.text_field :postal_code %>

  <%= form.label :address %>
  <%= form.text_field :address %>

  <%= form.label :telephone_number %>
  <%= form.text_field :telephone_number %>

  <%= form.label :email_address %>
  <%= form.email_field :email_address %>

  <%= form.label :password %>
  <%= form.password_field :password %>

  <%= form.label :password_confirmation %>
  <%= form.password_field :password_confirmation %>

  <%= form.submit %>

<% end %>