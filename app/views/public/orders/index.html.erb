<div class="container">
  <h2 class="bg-body-secondary rounded-0 px-3 py-1 mt-3 mb-5 d-inline-block fs-4">注文履歴一覧</h2>

  <table class="table table-bordered">
    <thead>
      <tr>
        <th class="bg-light">注文日</th>
        <th class="bg-light">配送先</th>
        <th class="bg-light">注文商品</th>
        <th class="bg-light">支払金額</th>
        <th class="bg-light">ステータス</th>
        <th class="bg-light">注文詳細</th>
      </tr>
    </thead>
    <tbody>
      <% @orders.each do |order| %>
        <tr>
          <td class="align-middle"><%= l(order.created_at.to_date) %></td>
          <td class="align-middle">
            〒<%= order.postal_code %><br>
            <%= order.address %><br>
            <%= order.name %>
          </td>
          <td class="align-middle">
            <% order.order_details.each do |detail| %>
              <%= detail.item.name %><br>
            <% end %>
          </td>
          <td class="align-middle"><%= number_with_delimiter(order.total_payment) %>円</td>
          <td class="align-middle"><%= order.status_i18n %></td>
          <td class="align-middle text-center">
            <%= link_to "表示する", order_path(order), class: "btn btn-primary btn-sm" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <div class="d-flex justify-content-center mt-4">
    <%= paginate @orders %>
  </div>
</div>
