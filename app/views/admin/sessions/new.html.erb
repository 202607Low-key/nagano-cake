<div class="container">
  <h2 class="bg-body-secondary rounded-0 px-3 py-1 my-5 d-inline-block fs-4">管理者ログイン</h2>
  <%= tag.div(flash[:alert], style: "color:red") if flash[:alert] %>

  <%= form_with url: admin_session_path do |f| %>
    <div class="row mb-3 align-items-center justify-content-center">
      <%= f.label :email_address, "メールアドレス", class: "col-sm-2 col-form-label" %>
      <div class="col-sm-6">
        <%= f.email_field :email_address, placeholder: "sample@example.com", required: true, autofocus: true, class: "form-control" %>
      </div>
    </div>

    <div class="row mb-5 align-items-center justify-content-center">
      <%= f.label :password, "パスワード", class: "col-sm-2 col-form-label" %>
      <div class="col-sm-6">
        <%= f.password_field :password, required: true, class: "form-control" %>
      </div>
    </div>

    <div class="row justify-content-center">
      <div class="col-sm-6 offset-sm-2">
        <%= f.submit "ログイン", class: "btn btn-primary px-5" %>
      </div>
    </div>
  <% end %>
</div>