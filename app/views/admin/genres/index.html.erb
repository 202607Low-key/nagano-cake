<div class="container">
  <h2 class="bg-body-secondary rounded-1 px-3 py-1 my-5 d-inline-block fs-4">ジャンル一覧・追加</h2>
  
  <%= render "form", genre: @genre, url: admin_genres_path, method: :post, submit_label: "新規登録" %>

  <div class="row">
    <div class="col-lg-4">
      <table class="table">
        <thead>
          <tr>
            <th class="bg-light genre-name-col text-center">ジャンル</th>
            <th class="bg-light genre-action-col"></th>
          </tr>
        </thead>
        <tbody>
          <% @genres.each do |genre| %>
            <tr>
              <td class="align-middle"><%= genre.name %></td>
              <td class="text-center">
                <%= link_to "編集する", edit_admin_genre_path(genre), class: "btn btn-success" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>