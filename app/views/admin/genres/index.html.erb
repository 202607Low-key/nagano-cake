<div class="container">
  <h2 class="bg-body-secondary rounded-1 px-3 text-center my-5 col-lg-3">ジャンル一覧・追加</h2>
  
  <% render "form", genre: @genre, url: admin_genres_path, method: :post, submit_label: "新規登録" %>

  <table class="table">
    <thead>
      <tr>
        <th class="bg-light">ジャンル</th>
      </tr>
    </thead>
    <tbody>
      <% @genres.each do |genre| %>
        <tr>
          <td class="align-middle"><%= genre.name %></td>
          <td>
            <%= link_to "編集する", edit_admin_genre_path(genre), class: "btn btn-success" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>