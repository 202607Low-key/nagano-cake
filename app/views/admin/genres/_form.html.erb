<%= form_with model: genre, url: url, method: method do |f| %>
  <% if genre.errors.any? %>
    <div class="mb-2" >
      <ul>
        <% genre.errors.full_messages.each do |msg| %>
          <li class="mb-2"><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row mb-4 align-items-center">
    <%= f.label :name, "ジャンル名", class: "col-xl-1 col-form-label fw-bold mb-2 pb-0" %>
    <div class="col-md-3 me-4">
      <%= f.text_field :name, placeholder: "ジャンル名", class: "form-control rounded-0 mb-2" %>
    </div>
    <div class="col-md-3">
      <%= f.submit submit_label, class: "btn btn-success px-4 mb-2" %>
    </div>
  </div>
<% end %>