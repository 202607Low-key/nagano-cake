<div class="container">
  <h2 class="bg-body-secondary rounded-0 px-3 py-1 mt-3 mb-5 d-inline-block fs-4">注文履歴詳細</h2>

  <div class="row mb-2">
    <div class="col-md-2 fw-bold">購入者</div>
    <div class="col-md-9"><%= link_to "#{@order.customer.last_name} #{@order.customer.first_name}", admin_customer_path(@order.customer), class: "text-black" %></div>
  </div>
  <div class="row mb-2">
    <div class="col-md-2 fw-bold">注文日</div>
    <div class="col-md-9"><%= l(@order.created_at.to_date) %></div>
  </div>
  <div class="row mb-2">
    <div class="col-md-2 fw-bold">配送先</div>
    <div class="col-md-9">
      〒<%= @order.postal_code %> <%= @order.address %><br>
      <%= @order.name %>
    </div>
  </div>
  <div class="row mb-2">
    <div class="col-md-2 fw-bold">支払方法</div>
    <div class="col-md-9"><%= @order.payment_method_i18n %></div>
  </div>
  <div class="row mb-5 align-items-center">
    <div class="col-md-2 fw-bold">注文ステータス</div>
    <div class="col-md-6">
      <%= form_with model: @order, url: admin_order_path(@order), method: :patch do |f| %>
        <div class="d-flex gap-4">
          <%= f.select :status, Order.statuses_i18n.map { |k, v| [v, k] }, {}, class: "form-select form-select-sm order-status-select text-center" %>
          <%= f.submit "更新", class: "btn btn-success" %>
        </div>
      <% end %>
    </div>
  </div>
  
  <div class="row align-items-end">
    <div class="col-lg-8">
      <table class="table border border-start-0 border-end-0 mb-3 small">
        <thead>
          <tr>
            <th class="bg-light border-bottom-0">商品名</th>
            <th class="bg-light border-bottom-0">単価( 税込 )</th>
            <th class="bg-light border-bottom-0">数量</th>
            <th class="bg-light border-bottom-0">小計</th>
            <th class="bg-light border-bottom-0 order-status-col">製作ステータス</th>
          </tr>
        </thead>
        <tbody>
          <% @order.order_details.each do |detail| %>
            <tr>
              <td class="align-middle border-bottom-0"><%= detail.item.name %></td>
              <td class="align-middle border-bottom-0"><%= number_with_delimiter(detail.price) %></td>
              <td class="align-middle border-bottom-0"><%= detail.amount %></td>
              <td class="align-middle border-bottom-0"><%= number_with_delimiter(detail.price * detail.amount) %></td>
              <td class="align-middle border-bottom-0">
                <%= form_with model: detail, url: admin_order_detail_path(detail), method: :patch do |f| %>
                  <div class="d-flex gap-4">
                    <%= f.select :making_status, OrderDetail.making_statuses_i18n.map { |k, v| [v, k] }, {}, class: "form-select form-select-sm order-status-select text-center" %>
                    <%= f.submit "更新", class: "btn btn-success btn-sm" %>
                  </div>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="col-6 col-lg-3 offset-lg-1 mb-3">
      <div class="row mb-2"><div class="col fw-bold">商品合計</div><div class="col text-end"><%= number_with_delimiter(@order.total_payment - @order.shipping_cost) %>円</div></div>
      <div class="row mb-2"><div class="col fw-bold">送料</div><div class="col text-end"><%= number_with_delimiter(@order.shipping_cost) %>円</div></div>
      <div class="row mb-2"><div class="col fw-bold">請求金額合計</div><div class="col text-end fw-bold"><%= number_with_delimiter(@order.total_payment) %>円</div></div>
    </div>
  </div>
</div>