<div class="container">
  <div class="d-flex justify-content-between align-items-center my-5">
    <h2 class="bg-body-secondary rounded-1 px-3 py-1 my-5 d-inline-block fs-4">商品一覧</h2>
    <%= link_to new_admin_item_path, class: "btn btn-outline-secondary rounded-circle" do %>
      <i class="fa-solid fa-plus"></i>
    <% end %>
  </div>

  <table class="table border border-start-0 border-end-0">
    <thead>
      <tr>
        <th class="bg-light border-bottom-0">商品ID</th>
        <th class="bg-light border-bottom-0">商品名</th>
        <th class="bg-light border-bottom-0">税抜価格</th>
        <th class="bg-light border-bottom-0">ジャンル</th>
        <th class="bg-light border-bottom-0">ステータス</th>
      </tr>
    </thead>
    <tbody>
      <% @items.each do |item| %>
        <tr>
          <td class="align-middle border-bottom-0"><%= item.id %></td>
          <td class="align-middle border-bottom-0"><%= link_to item.name, admin_item_path(item), class: "text-black" %></td>
          <td class="align-middle border-bottom-0"><%= number_with_delimiter(item.price) %></td>
          <td class="align-middle border-bottom-0"><%= item.genre.name %></td>
          <td class="align-middle border-bottom-0">
            <% if item.is_active? %>
              <span class="text-success fw-bold">販売中</span>
            <% else %>
              <span class="text-muted">販売停止中</span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <div class="d-flex justify-content-center mt-4">
    <%= paginate @items %>
  </div>
</div>