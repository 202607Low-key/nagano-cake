<div class="container">
  <div class="d-flex justify-content-between align-items-center my-5">
    <h2 class="bg-body-secondary rounded-1 px-3 py-1 my-5 d-inline-block fs-4">商品一覧</h2>
    <%= link_to new_admin_item_path, class: "btn btn-outline-secondary rounded-circle" do %>
      <i class="fa-solid fa-plus"></i>
    <% end %>
  </div>

  <table class="table">
    <thead>
      <tr>
        <th class="bg-light">商品ID</th>
        <th class="bg-light">商品名</th>
        <th class="bg-light">税抜価格</th>
        <th class="bg-light">ジャンル</th>
        <th class="bg-light">ステータス</th>
      </tr>
    </thead>
    <tbody>
      <% @items.each do |item| %>
        <tr>
          <td class="align-middle"><%= item.id %></td>
          <td class="align-middle"><%= link_to item.name, admin_item_path(item) %></td>
          <td class="align-middle"><%= number_with_delimiter(item.price) %></td>
          <td class="align-middle"><%= item.genre.name %></td>
          <td class="align-middle">
            <% if item.is_active? %>
              <span class="text-success fw-bold>販売中</span>
            <% else %>
              <span class="text-muted">販売停止中</span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>