<div class="container">
  <h2 class="bg-body-secondary rounded-0 px-3 py-1 mt-3 mb-5 d-inline-block fs-4">会員一覧</h2>

  <table class="table border border-start-0 border-end-0">
    <thead>
      <tr>
        <th class="bg-light">会員ID</th>
        <th class="bg-light">氏名</th>
        <th class="bg-light">メールアドレス</th>
        <th class="bg-light">ステータス</th>
      </tr>
    </thead>
    <tbody>
      <% @customers.each do |customer| %>
        <tr>
          <td class="align-middle"><%= customer.id %></td>
          <td class="align-middle"><%= link_to "#{customer.last_name} #{customer.first_name}", admin_customer_path(customer), class: "text-black" %></td>
          <td class="align-middle"><%= customer.email_address %></td>
          <td class="align-middle">
            <% if customer.is_active? %>
              <span class="text-success fw-bold">有効</span>
            <% else %>
              <span class="text-muted">退会</span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <div class="d-flex justify-content-center mt-4">
    <%= paginate @customers %>
  </div>
</div>
